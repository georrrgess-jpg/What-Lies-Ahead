[resource]
script = ExtResource("1")
id = &"ground_control"
sort_order = 107
category = "Radar Dish"
slot_class = "primary"
display_name = "Ground Control"
role = "Hold to charge, release to send a radar ping ring: a tap is a small, fast ping; holding grows it in three steps up to a huge, slow ring that knocks zombies back. Rings pass through every zombie in them and bounce once off a wall, so they can hit the crowd again on the way back. Every zombie a ring touches is outlined through walls for 4 s and takes +15% damage from every weapon. Hold a full charge until the dish turns pink and release for a wide feedback blast; hold it too long and the gun stalls."
