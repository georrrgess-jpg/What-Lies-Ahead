[resource]
script = ExtResource("1")
id = &"t_minus_six"
sort_order = 125
category = "Rocket Pistol"
slot_class = "secondary"
display_name = "T-Minus Six"
role = "Pocket rocket launchpad. Hold aim and the radar paints the zombie nearest the crosshair every third of a second, one lock per rocket in the pod: sweep across a pack to spread the locks, or hold on one zombie to stack them. Pull the trigger and the swarm launches, corkscrewing out and homing in on the painted heads, each rocket popping with a small splash. With nothing painted it dumb-fires one straight rocket. The rockets are light: made for packs down a lane, not for bosses. Reloading with rockets left in the pod is quicker."
