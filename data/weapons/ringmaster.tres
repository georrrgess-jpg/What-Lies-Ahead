[resource]
script = ExtResource("1")
id = &"ringmaster"
sort_order = 118
category = "Assault Rifle"
slot_class = "primary"
display_name = "Ringmaster"
role = "The star of the show: a brass, crimson and gold assault rifle with a three-ring spinning drum. Full-auto at 13 a second, accurate, hard-hitting out to long range and quick in the hands, with 60 rounds a drum. Spotlight: kills fill the meter on the drum's outer bulbs (headshot kills count double). The Main Event: with the meter full, hold aim for a moment to call it: for 6 s the drum spins up to 17 a second, every round is a spotlight beam that passes through a second zombie, and every kill pops a confetti burst that hurts the crowd round it and can set off the next."
