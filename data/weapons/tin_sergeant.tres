[resource]
script = ExtResource("1")
id = &"tin_sergeant"
sort_order = 113
category = "Squad Launcher"
slot_class = "primary"
display_name = "Tin Sergeant"
role = "A toy-chest launcher that lobs wind-up tin soldiers, up to six out at once (one more pops the oldest). Each lands, winds up and marches on the nearest zombie by itself (a squad spreads over a pack), then pops on it: 120 to it, less to everything within 2.6 m, and light zombies near the middle see stars. One that hits a zombie in flight clonks it and pops at once. Hold aim to plant a \"Fall in!\" flag where the arc lands: the squad marches to it, rings it and guards it, and it holds 6 s after you lower the sights. Soldiers run down after 12 s and keep marching when you switch guns. Slow to hit a lone target, strong at holding a lane; bosses take 85%."
