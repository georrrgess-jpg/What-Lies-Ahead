[resource]
script = ExtResource("1")
id = &"claw_grabber"
sort_order = 127
category = "Claw Machine Pistol"
slot_class = "secondary"
display_name = "Claw Grabber"
role = "A prize claw machine shrunk into a pistol: every shot fires the chrome claw on its cable. The first zombie it reaches takes the hit and, if the claw can lift it, is grabbed, yanked to your feet and dropped there stunned (bowled over for nearly two seconds), and it is Prized: 35% more damage from every hit, whatever the weapon, for 4 seconds. Heavies and bosses are too big to lift: the claw slips off, but they are Prized too. Hold the trigger as the claw grips a heavy, a wall or the floor and it reels you there: a grapple dash of up to 16 m, only to floor you could walk to, then 3.5 s to recharge (the GRAB button on the gun lights up when it is ready). Six credits a token and the claw must come home between shots: a utility sidearm, not a hose."
