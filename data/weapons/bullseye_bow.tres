[resource]
script = ExtResource("1")
id = &"bullseye_bow"
sort_order = 115
category = "Recurve Bow"
display_name = "Bullseye Longbow"
role = "A carnival archery-gallery recurve that looses real arrows. Hold to draw (the limbs bend, the string pulls back), release to loose: a full draw flies fast with a slight drop. At full draw a ring tightens round the crosshair and the arrowhead glints: release then for a BULLSEYE (x1.4, faster, passes through two zombies and pins the next). Hold past it and your arm tires: the aim trembles. Arrows stick in what they hit; walk over a stuck arrow to pick it up. One arrow at a time: precise and deadly at range, weak against a swarm up close."
