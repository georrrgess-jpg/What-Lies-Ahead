[resource]
script = ExtResource("1")
id = &"ticket_flipper"
display_name = "Ticket Flipper"
role = "Prize-ticket butterfly knife that never stops flipping. Speed is the point: you run, sprint and slide 20% faster with it out and it comes up in a flash. A light slash (FIRE) is quick but light. Hold AIM to wind up and let go to lunge: you dash forward and cut everything in front of you. Heavies and alphas shrug off half of every cut. No ammo, no reload: press 3 to draw it, or MELEE for a quick slash with any gun."
