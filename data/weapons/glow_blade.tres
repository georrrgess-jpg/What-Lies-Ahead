[resource]
script = ExtResource("1")
id = &"glow_blade"
display_name = "Glow Blade"
role = "Neon switchblade that flicks open when you draw it. Speed is the point: you run, sprint and slide 15% faster with it out, it comes up in a blink, and a light slash (FIRE) is quick but light. Hold AIM to wind up a heavy slash and let go to strike: it staggers anything short of a heavy. A stab in the back deals double. Heavies and alphas shrug off half of every cut. No ammo, no reload: press 3 to draw it, or MELEE (T or middle mouse) for a quick slash with any gun."
