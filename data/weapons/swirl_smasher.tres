script = ExtResource("1")
id = &"swirl_smasher"
display_name = "Swirl Smasher"
role = "A giant rainbow swirl lollipop on a stick. Wide, sweeping swings (FIRE) that hit up to four zombies at once and knock them back. Hold AIM to wind up and let go to smash: the candy cracks and sprays sugar shards that slow every zombie round the impact. Slower than a knife; heavies and alphas take less from every swing. No ammo, no reload: press 3 to draw it, or MELEE for a quick swing with any gun."
