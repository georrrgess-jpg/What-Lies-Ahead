[resource]
script = ExtResource("1")
id = &"high_striker"
display_name = "High Striker"
role = "The strongman game's mallet. Very slow and very heavy: a light swing (FIRE) clobbers up to three zombies and throws them back, and you walk a little slower with it out. Hold AIM to haul it overhead and let go to slam the ground: the puck flies up the scale, rings the bell and the shock stuns every zombie round you. Heavies and alphas take less from every swing. No ammo, no reload: press 3 to draw it, or MELEE for a quick swing with any gun."
