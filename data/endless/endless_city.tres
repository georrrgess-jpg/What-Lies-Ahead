[sub_resource type="Resource" id="rules"]
script = ExtResource("2")
districts = Array[ExtResource("3")]([SubResource("d_square"), SubResource("d_precinct"), SubResource("d_metro"), SubResource("d_market"), SubResource("d_tower")])
base_enemies = Array[StringName]([&"city_shambler", &"city_runner", &"city_bruiser"])
boss_id = &"the_wrecker"
boss_every = 10
economy = SubResource("economy")

[resource]
script = ExtResource("1")
id = &"endless_city"
display_name = "Ashfall City"
blurb = "Endless. A burnt-out city that never stops coming. Hold the square, then buy your way through the gates into the rest of the city."
scene_path = "res://scenes/levels/endless_city.tscn"
requires_level = &""
sort_order = 0
music = &"city_endless_loop"
music_final = &"city_endless_final"
ambience = &"city_ambience"
music_volume_db = -7.0
ambience_volume_db = -10.0
accent_color = Color(1, 0.42, 0.16, 1)
menu_camera_from = Vector3(17, 7.5, 21)
menu_camera_to = Vector3(-3, 2.5, -8)
heal_item_name = "Canned peaches"
loading_tips = PackedStringArray("Every district you open widens the city and wakes its entrances: open one when you can hold more ground, not just because you can afford it.", "Pay at any gate of a district and all of its gates open. Broadcast Tower has two: the Market's north alley and the Metro's east stairs.", "Riot cops in Precinct 9 block shots from the front. Go over the shield's rim or round its side.", "Down on the Metro platform the pillars split it into two lanes: circle them to shake off a crowd.", "Firebugs in the Neon Market wind up before they throw. Watch the bottle and step off the burning patch.", "Fire and shock traps cost a few tickets to arm. Lead the crowd through them.", "Every few waves a supply crate drops into an open district: ammo, a heal and tickets.", "Every tenth wave the Wrecker comes. The Broadcast Tower plaza is the widest ground to fight it on.", "The Upgrade Bench beside the loadout station (and another in the Broadcast Tower) upgrades the weapon in hand for the run: Mk I hits harder, Mk II carries a bigger magazine and reloads faster, Mk III hits hardest and glows.", "Now and then a fallen zombie drops a power-up: Double Tickets, Max Ammo, Blast Wave or Rapid Fire. It blinks before it goes, so grab it quick.", "The wave after the Wrecker is a breather: a few slow zombies. Spend it at the bench and the gates.", "A surge warning names the district and where it lies from you. Face that way before the pack pours in.")
endless = SubResource("rules")
