[sub_resource type="Resource" id="d_square"]
script = ExtResource("3")
id = &"ashfall_square"
display_name = "Ashfall Square"
blurb = "The old town square: a toppled statue, burning cars and the last working loadout station."
price = 0
enemies = Array[StringName]([])
accent_color = Color(1, 0.48, 0.18, 1)

[sub_resource type="Resource" id="d_precinct"]
script = ExtResource("3")
id = &"precinct"
display_name = "Precinct 9"
blurb = "The police station and its car park of riot vans. The riot squad never clocked off."
price = 600
enemies = Array[StringName]([&"riot_shield"])
accent_color = Color(0.25, 0.55, 1, 1)

[sub_resource type="Resource" id="d_metro"]
script = ExtResource("3")
id = &"metro"
display_name = "Metro Line"
blurb = "Down the stairs to the flooded platforms, lit by emergency lamps. Something crawls in the tunnels."
price = 1000
enemies = Array[StringName]([&"tunnel_crawler"])
accent_color = Color(0.3, 1, 0.55, 1)

[sub_resource type="Resource" id="d_market"]
script = ExtResource("3")
id = &"market"
display_name = "Neon Market"
blurb = "A collapsed street of stalls under flickering neon. Mind the ones carrying bottles."
price = 1400
enemies = Array[StringName]([&"firebug"])
accent_color = Color(1, 0.25, 0.75, 1)

[sub_resource type="Resource" id="d_tower"]
script = ExtResource("3")
id = &"tower"
display_name = "Broadcast Tower"
blurb = "The foot of the broken skyscraper and its radio mast. Whatever wrecked the city sleeps here."
price = 1800
enemies = Array[StringName]([&"city_bruiser"])
accent_color = Color(1, 0.85, 0.3, 1)

[sub_resource type="Resource" id="economy"]
script = ExtResource("4")
prep_seconds = 15.0
