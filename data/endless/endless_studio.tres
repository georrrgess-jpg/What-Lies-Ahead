[resource]
script = ExtResource("1")
id = &"endless_studio"
display_name = "Starlot Studios"
blurb = "Endless. A haunted movie backlot at night. Hold the front lot under the water tower, then buy your way onto the sets."
scene_path = "res://scenes/levels/endless_studio.tscn"
requires_level = &""
requirement = SubResource("unlock")
sort_order = 1
music = &"studio_endless_loop"
music_final = &"studio_endless_final"
ambience = &"studio_ambience"
music_volume_db = -7.0
ambience_volume_db = -10.0
accent_color = Color(1, 0.72, 0.3, 1)
menu_camera_from = Vector3(56, 2.4, -31)
menu_camera_to = Vector3(56, 9, -84)
heal_item_name = "Craft-services coffee"
loading_tips = PackedStringArray("Every set you open widens the lot and wakes its stage doors: open one when you can hold more ground, not just because you can afford it.", "Pay at either gate of Premiere Boulevard (the Monster Lot's east gate or Soundstage 7's north door) and both open.", "Western Street's painted desert is only a flat: there is room to circle behind it, past the scaffolding.", "Inside Soundstage 7 the bridge set's walls split the floor into lanes. Use them to break a crowd's line.", "The fog in the Monster Lot hides the graves' edges: keep to the cobbled path when you back up.", "Fire and shock traps cost a few tickets to arm. Lead the crowd through them.", "Every few waves a supply crate drops onto an open set: ammo, a heal and tickets.", "Every tenth wave the Wrecker crashes the premiere. The red carpet is the widest ground to fight it on.", "The Upgrade Bench beside the loadout station (and another on Premiere Boulevard) upgrades the weapon in hand for the run.", "Now and then a fallen zombie drops a power-up. It blinks before it goes, so grab it quick.", "The wave after the Wrecker is a breather: a few slow zombies. Spend it at the bench and the gates.")
endless = SubResource("rules")
