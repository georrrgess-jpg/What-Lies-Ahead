[resource]
script = ExtResource("1")
id = &"boomtown"
display_name = "Boomtown"
blurb = "Hold Main Street round the Prospector Supply wagon, between the saloon and the livery, under the mine train's loop, then follow the lanterns out through the BOOMTOWN gate."
scene_path = "res://scenes/levels/boomtown.tscn"
