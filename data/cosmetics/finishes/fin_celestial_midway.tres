script = ExtResource("1")
id = &"fin_celestial_midway"
display_name = "Celestial Midway"
description = "A window onto the midnight sky over the fair, carried inside the weapon: a violet nebula drifts far back, stars twinkle at three depths and slide past each other as you move, aurora ribbons sway in teal and pink, and gold constellations draw themselves into a Ferris wheel, a balloon, a crown, a rocket, a teacup and a wishing star. Pierced gold filigree frames the night, and every kill sends a shooting star across it. Earned by the few who reach 50,000 kills."
