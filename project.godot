; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="What Lies Ahead"
config/description="First-person arcade zombie survival. World 1: Boardwalk Breakout."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Profile="*res://scripts/autoload/profile.gd"
GameData="*res://scripts/autoload/game_data.gd"
Settings="*res://scripts/autoload/settings.gd"
Events="*res://scripts/autoload/events.gd"
Unlocks="*res://scripts/autoload/unlocks.gd"
Progression="*res://scripts/autoload/progression.gd"
Mastery="*res://scripts/autoload/mastery.gd"
Wallet="*res://scripts/autoload/wallet.gd"
Cosmetics="*res://scripts/autoload/cosmetics.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

